<?xml version="1.0"?>
<!--
  Simple URDF for 70 kg mannequin (supine position)
  Used as load simulator for testing cushion.
-->
<robot name="mannequin_supine">

  <link name="head">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.09"/>
      </geometry>
      <material name="skin">
        <color rgba="0.9 0.8 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.09"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <link name="torso">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.30 0.25"/>
      </geometry>
      <material name="skin">
        <color rgba="0.9 0.8 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.30 0.25"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="35.0"/>
      <inertia ixx="0.5" ixy="0" ixz="0" iyy="0.4" iyz="0" izz="0.3"/>
    </inertial>
  </link>

  <joint name="head_to_torso" type="fixed">
    <parent link="torso"/>
    <child link="head"/>
    <origin xyz="0.0 0.30 0.0" rpy="0 0 0"/>
  </joint>

  <link name="left_arm">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.55 0.10"/>
      </geometry>
      <material name="skin"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.55 0.10"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="4.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="left_arm_to_torso" type="fixed">
    <parent link="torso"/>
    <child link="left_arm"/>
    <origin xyz="-0.22 0.05 0.05" rpy="0 0 0"/>
  </joint>

  <link name="right_arm">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.55 0.10"/>
      </geometry>
      <material name="skin"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.55 0.10"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="4.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="right_arm_to_torso" type="fixed">
    <parent link="torso"/>
    <child link="right_arm"/>
    <origin xyz="0.22 0.05 0.05" rpy="0 0 0"/>
  </joint>

  <link name="left_leg">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.40 0.15"/>
      </geometry>
      <material name="skin"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.40 0.15"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="11.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <joint name="left_leg_to_torso" type="fixed">
    <parent link="torso"/>
    <child link="left_leg"/>
    <origin xyz="-0.10 -0.35 0.0" rpy="0 0 0"/>
  </joint>

  <link name="right_leg">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.40 0.15"/>
      </geometry>
      <material name="skin"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.40 0.15"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="11.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <joint name="right_leg_to_torso" type="fixed">
    <parent link="torso"/>
    <child link="right_leg"/>
    <origin xyz="0.10 -0.35 0.0" rpy="0 0 0"/>
  </joint>

</robot>
