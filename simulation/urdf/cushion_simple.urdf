<?xml version="1.0"?>
<!--
  Simple URDF for Air Cushion (test nhanh không cần Gazebo dynamics)
  - 8x8 = 64 cells (visualized as one large box for simplicity)
  - Foam support layer below
  - Includes pressure sensor plugin (Gazebo)
-->
<robot name="air_cushion">

  <!-- Link: foam base (passive safety) -->
  <link name="foam_base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.8 0.05"/>
      </geometry>
      <material name="foam_orange">
        <color rgba="1.0 0.7 0.4 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.8 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <link name="base_plate">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.8 0.008"/>
      </geometry>
      <material name="petg_gray">
        <color rgba="0.5 0.6 0.65 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.8 0.008"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.2"/>
      <inertia ixx="0.04" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.08"/>
    </inertial>
  </link>

  <joint name="base_to_foam" type="fixed">
    <parent link="foam_base"/>
    <child link="base_plate"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
  </joint>

  <link name="air_cell_layer">
    <visual>
      <origin xyz="0 0 0.066" rpy="0 0 0"/>
      <geometry>
        <box size="0.96 0.76 0.030"/>
      </geometry>
      <material name="silicone_orange">
        <color rgba="1.0 0.8 0.5 0.6"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.066" rpy="0 0 0"/>
      <geometry>
        <box size="0.96 0.76 0.030"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <joint name="cell_to_base" type="fixed">
    <parent link="base_plate"/>
    <child link="air_cell_layer"/>
    <origin xyz="0 0 0.029" rpy="0 0 0"/>
  </joint>

  <link name="sensor_mat">
    <visual>
      <origin xyz="0 0 0.082" rpy="0 0 0"/>
      <geometry>
        <box size="0.98 0.78 0.0005"/>
      </geometry>
      <material name="velostat_dark">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.082" rpy="0 0 0"/>
      <geometry>
        <box size="0.98 0.78 0.0005"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="sensor_to_cell" type="fixed">
    <parent link="air_cell_layer"/>
    <child link="sensor_mat"/>
    <origin xyz="0 0 0.016" rpy="0 0 0"/>
  </joint>

  <link name="sacrum_sensor_link"/>
  <joint name="sacrum_sensor_joint" type="fixed">
    <parent link="sensor_mat"/>
    <child link="sacrum_sensor_link"/>
    <origin xyz="0 0 0.001" rpy="0 0 0"/>
  </joint>

  <gazebo>
    <plugin name="cushion_gazebo_plugin" filename="libcushion_plugin.so">
      <n_cells>64</n_cells>
      <rows>8</rows>
      <cols>8</cols>
      <max_pressure>80.0</max_pressure>
      <response_time>0.3</response_time>
      <update_rate>10.0</update_rate>
      <topic_pressure>/cushion/pressure</topic_pressure>
      <topic_cmd>/cushion/cmd</topic_cmd>
    </plugin>
  </gazebo>

</robot>
