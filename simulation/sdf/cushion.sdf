<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='air_cushion'>
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>

    <link name='foam_base'>
      <pose>0 0 0 0 0 0</pose>
      <collision name='foam_collision'>
        <geometry>
          <box><size>1.0 0.8 0.05</size></box>
        </geometry>
      </collision>
      <visual name='foam_visual'>
        <geometry>
          <box><size>1.0 0.8 0.05</size></box>
        </geometry>
        <material>
          <ambient>1.0 0.7 0.4 1</ambient>
          <diffuse>1.0 0.7 0.4 1</diffuse>
        </material>
      </visual>
    </link>

    <link name='base_plate'>
      <pose>0 0 0.029 0 0 0</pose>
      <collision name='base_collision'>
        <geometry>
          <box><size>1.0 0.8 0.008</size></box>
        </geometry>
      </collision>
      <visual name='base_visual'>
        <geometry>
          <box><size>1.0 0.8 0.008</size></box>
        </geometry>
        <material>
          <ambient>0.5 0.6 0.65 1</ambient>
          <diffuse>0.5 0.6 0.65 1</diffuse>
        </material>
      </visual>
    </link>

    <link name='cell_0'>
      <pose>-0.35 0.35 0.066 0 0 0</pose>
      <collision name='c0_collision'>
        <geometry>
          <box><size>0.10 0.10 0.001</size></box>
        </geometry>
      </collision>
      <visual name='c0_visual'>
        <geometry>
          <box><size>0.10 0.10 0.001</size></box>
        </geometry>
        <material>
          <ambient>1.0 0.8 0.5 0.7</ambient>
          <diffuse>1.0 0.8 0.5 0.7</diffuse>
        </material>
      </visual>
    </link>

    <link name='sacrum_sensor'>
      <sensor name='sacrum_pressure' type='altimeter'>
        <pose>0 0 0.083 0 0 0</pose>
        <update_rate>10</update_rate>
        <altimeter>
          <vertical_position>0.083</vertical_position>
        </altimeter>
        <plugin name='cushion_plugin' filename='cushion_plugin.so'>
          <n_cells>64</n_cells>
          <rows>8</rows>
          <cols>8</cols>
          <max_pressure>80.0</max_pressure>
          <response_time>0.3</response_time>
          <topic_pressure>/cushion/pressure</topic_pressure>
          <topic_cmd>/cushion/cmd</topic_cmd>
        </plugin>
      </sensor>
    </link>

  </model>
</sdf>
